# GENSA — contoh variabel lingkungan (backend server/)
#
# Salin ke `.env` dan isi nilai aslinya. JANGAN pernah commit
# berkas `.env` yang berisi nilai asli (sudah diabaikan .gitignore).
# Demo v1 (index.html) tetap berjalan tanpa variabel ini.
DATABASE_URL=
PORT=3101
SESSION_SECRET=
ADMIN_EMAIL=admin@gensa.local
ADMIN_PASSWORD=

# Login Google (opsional — isi dari Google Cloud Console, OAuth client web).
# Tanpa ini, tombol login Google menampilkan "belum dikonfigurasi".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3101/api/auth/google/callback

# Deploy di belakang reverse proxy (mis. Vercel): percayai header
# x-forwarded-proto untuk cek Origin dan flag Secure pada cookie.
# Isi 1 di Vercel; biarkan kosong/0 bila server diakses langsung (lokal).
TRUST_PROXY=0
# Basis URL publik aplikasi (mis. https://gensa.vercel.app) — dipakai
# untuk tautan reset password. Kosongkan bila jalan lokal.
APP_URL=

# Email reset password via SMTP (opsional — bila kosong, tautan reset
# hanya tampil di log server dan Admin melihat peringatan di halaman Akun).
# Contoh Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=0,
# SMTP_USER=alamat@gmail.com, SMTP_PASS=<App Password 16 karakter dari
# Google Account > Keamanan > Verifikasi 2 langkah > Sandi aplikasi>.
# SMTP_SECURE=1 hanya bila port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

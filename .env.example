# GENSA — contoh variabel lingkungan (backend server/)
#
# Salin ke `.env` dan isi nilai aslinya. JANGAN pernah commit
# berkas `.env` yang berisi nilai asli (sudah diabaikan .gitignore).
# Demo v1 (index.html) tetap berjalan tanpa variabel ini.
DATABASE_URL=
PORT=3101
SESSION_SECRET=
ADMIN_EMAIL=admin@gensa.local
ADMIN_PASSWORD=

# Login Google (opsional — isi dari Google Cloud Console, OAuth client web).
# Tanpa ini, tombol login Google menampilkan "belum dikonfigurasi".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3101/api/auth/google/callback
